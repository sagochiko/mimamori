# eval: the holdout set and the unsplit pool stay out of git (and out of grep) until the final
# measurement; /mm-endgame publishes them after that run.
eval/cases/holdout/*
eval/cases/pool/*
!eval/cases/holdout/.gitkeep
!eval/cases/pool/.gitkeep
eval/out/

