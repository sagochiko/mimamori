# secrets: never commit
.dev.vars
.dev.vars.*
!.dev.vars.example
*.p8
*.p12
*.mobileprovision
client_secret*.json
.env
.env.*

# Claude Code: per-machine settings and runtime state
.claude/settings.local.json
.claude/prior-work.local
.claude/private-terms.local
.claude/worktrees/
.claude/state/
.claude/logs/
# A hook run with server/ as its root writes its state under server/.claude/; it was swept into commits
# three times (2026-11-06 twice, PR #183 on 2026-11-07). Late on 2026-11-07 the same happened under video/,
# so any top-level folder's .claude/ is ignored. The root .claude/ is not matched.
/*/.claude/
CLAUDE.local.md

# Apple's skills exported from Xcode (`make apple-skills`). Apple's content, not ours to redistribute.
.claude/skills/swiftui-specialist/
.claude/skills/swiftui-whats-new-27/
.claude/skills/modernize-tests/

# eval: the holdout set and the unsplit pool stay out of git (and out of grep) until the final
# measurement; /mm-endgame publishes them after that run.
eval/cases/holdout/*
eval/cases/pool/*
!eval/cases/holdout/.gitkeep
!eval/cases/pool/.gitkeep
eval/out/

# build output
node_modules/
.wrangler/
dist/
build/
DerivedData/
*.xcresult
.verify.log
spikes/

.DS_Store

# The mother family's SMS token for her build (ios/Config/Mother.xcconfig.example)
ios/Config/Mother.xcconfig
