#!/bin/bash
# commit-msg: the commit convention of this repository, checked on every commit.
#   <type>(<scope>): <日本語の要約>
#   (空行)
#   なぜ変えたか。
#   Refs #12
# The repository becomes public, so this also refuses personal data in messages (scripts/scan-private.sh),
# a time of day in the author's weekday working hours (the same script), and the names of the author's
# earlier projects.
export LC_ALL=en_US.UTF-8
msg_file=$1
root=$(git rev-parse --show-toplevel) || exit 1
subject=$(grep -v '^#' "$msg_file" | head -1)
body=$(grep -v '^#' "$msg_file")
fail() { echo "commit-msg: $1" >&2; echo "  subject: $subject" >&2; exit 1; }
# For a scan hit the subject is not echoed: it may hold the very term or time that was stopped.
refuse() { echo "commit-msg: $1" >&2; exit 1; }

# Personal data and work-hour times, in every message, merges and reverts included. Only where and
# which rule are shown.
out=$("$root/scripts/scan-private.sh" message "$msg_file")
case $? in
  0) ;;
  1)
    hint=""
    grep -q ': work-hour time$' <<<"$out" &&
      hint=$'\n'"A work-hour time is a time of day from ten to noon or from one to seven in the afternoon, the author's weekday working hours. Public records give the date alone, or 午後, for what happened then; the hook cannot tell whose action or which day a time records, so it stops every such time. Write the date alone or 午後 (for the app's own hours, 既定の時刻)."
    refuse "the message looks like it holds personal data or a work-hour time (the text itself is not shown):"$'\n'"$(sed 's/^/  /' <<<"$out")$hint" ;;
  *) refuse "the personal-data scan could not run" ;;
esac

# The earlier projects are listed in a gitignored file that only the main working tree has. In a git
# worktree, find the main tree through the common git directory (--show-toplevel names the worktree).
# scripts/test-hooks.sh points MM_PRIOR_WORK_FILE at a dummy list.
list=${MM_PRIOR_WORK_FILE:-}
if [[ -z "$list" ]] && common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  list=$(dirname "$common")/.claude/prior-work.local
fi
if [[ -s "$list" ]]; then
  shopt -s nocasematch
  while IFS= read -r dir; do
    [[ -z "$dir" || "$dir" == \#* ]] && continue
    [[ "$body" == *"${dir##*/}"* ]] && refuse "the message names one of the author's earlier projects; this repository keeps them private"
  done <"$list"
  shopt -u nocasematch
fi

case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac

types='feat|fix|test|docs|refactor|chore|eval|harness'
if [[ ! "$subject" =~ ^($types)(\((ios|server|eval|harness|docs|plan|repo)\))?:\ .+ ]]; then
  fail "the subject must look like 'feat(server): 招待コードで家族に入れるようにする' (types: ${types//|/, }; scopes: ios, server, eval, harness, docs, plan, repo)"
fi
summary=${subject#*: }
((${#summary} > 50)) && fail "keep the summary within 50 characters (${#summary} now); put the reason in the body"

grep -q '^Claude-Session:' <<<"$body" && fail "do not add a Claude-Session line in this repository"
exit 0
