{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "language": "japanese",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(make verify*)",
      "Bash(make eval)",
      "Bash(make usage*)",
      "Bash(swift test*)",
      "Bash(swift build*)",
      "Bash(xcodebuild *)",
      "Bash(xcrun swift-format *)",
      "Bash(xcrun simctl *)",
      "Bash(xcrun xcresulttool *)",
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx tsx eval/*)",
      "Bash(npx wrangler types*)",
      "Bash(npx wrangler dev *)",
      "Bash(npx wrangler tail *)",
      "Bash(npx wrangler whoami*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler deployments *)",
      "Bash(npx wrangler rollback*)",
      "Bash(npx wrangler versions *)",
      "Bash(npx wrangler secret put *)",
      "Bash(npx wrangler secret list*)",
      "Bash(openssl rand *)",
      "Bash(npx wrangler d1 migrations create *)",
      "Bash(npx wrangler d1 migrations list * --local*)",
      "Bash(npx wrangler d1 migrations apply * --local*)",
      "Bash(npx wrangler d1 migrations * --remote*)",
      "Bash(npx wrangler d1 execute * --local*)",
      "Bash(npx wrangler d1 execute * --remote*)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh project *)",
      "Bash(gh api *)",
      "Bash(gh auth status*)",
      "Bash(git push*)",
      "mcp__claude-docs__search_docs",
      "mcp__claude-docs__get_doc",
      "mcp__claude-docs__get_navigation",
      "mcp__claude-docs__get_api_endpoint",
      "mcp__cloudflare-docs__search_cloudflare_documentation"
    ],
    "ask": [
      "Bash(*wrangler secret delete*)",
      "Bash(*wrangler versions secret delete*)",
      "Bash(xcrun simctl erase *)",
      "Bash(xcrun simctl delete *)",
      "Bash(gh pr merge*--admin*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)"
    ],
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(!**/.dev.vars.example)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/AuthKey_*)",
      "Read(**/client_secret*.json)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.config/gh/**)",
      "Read(eval/cases/holdout/**)",
      "Bash(*wrangler delete*)",
      "Bash(*wrangler d1 delete*)",
      "Bash(*wrangler queues delete*)",
      "Bash(*wrangler r2 bucket delete*)",
      "Bash(*wrangler d1 time-travel restore*)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
      "Bash(security find-*)",
      "Bash(printenv*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f)",
      "Bash(git push* -f *)",
      "Bash(git push* +*)",
      "Bash(git -c * push*--force*)",
      "Bash(git -c * push* -f)",
      "Bash(git -c * push* -f *)",
      "Bash(git -c * push* +*)",
      "Bash(gh repo edit*visibility*)",
      "Bash(gh issue delete*)"
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "aws-core@agent-toolkit-for-aws": false,
    "aws-agents@agent-toolkit-for-aws": false,
    "aws-agents-for-devsecops@agent-toolkit-for-aws": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false
  },
  "skillOverrides": {
    "agents-sdk": "off",
    "app-store-listing": "off",
    "career-report": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "durable-objects": "off",
    "google-drive-upload": "off",
    "sago3-deploy": "off",
    "sandbox-sdk": "off",
    "turnstile-spin": "off",
    "web-perf": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "timeout": 20,
            "statusMessage": "締切と今の条件を読み込み中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Monitor|Edit|Write|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prior-work.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-holdout.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prod.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-merge.sh",
            "timeout": 90,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-private.sh",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Skill|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-log.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/save-report.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-log.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-log.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.sh",
            "timeout": 600,
            "statusMessage": "変わった側のテストを確認中"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pacer.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/compact-flag.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "idleCompaction": false
}
